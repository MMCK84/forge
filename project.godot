; Engine configuration file.
; Godot 4.3+

config_version=5

[application]

config/name="Forge Workshop"
config/description="2D-Schmiede-Simulation mit Incremental-/Tycoon-Elementen im Großbritannien des 18. Jahrhunderts"
config/version="0.1.0"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
config/quit_on_go_back=false
config/auto_accept_quit=false

[autoload]

GameManager="*res://scenes/autoload/game_manager.gd"
SaveManager="*res://scenes/autoload/save_manager.gd"
SoundManager="*res://scenes/autoload/sound_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_mouse_from_touch=true

[internationalization]

locale/fallback="en"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
